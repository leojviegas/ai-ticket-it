            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Camila\",\n  \"apellido\": \"Vega\",\n  \"email\": \"camila.{{$timestamp}}@ticketit.com\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Crea una cuenta nueva, hashea la contraseña con bcryptjs y devuelve accessToken + usuario."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
