                { "key": "precioMax", "value": "30000", "disabled": true },
                { "key": "soloFuturos", "value": "true" },
                { "key": "ordenarPor", "value": "precio" },
                { "key": "orden", "value": "asc" }
              ]
            },
            "description": "Permite buscar por texto (q), filtrar por categoría, rango de precios y soloFuturos, y ordenar por precio, fecha o puntaje."
