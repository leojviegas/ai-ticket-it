            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Noche de Jazz Electrónico\",\n  \"descripcion\": \"Presentación en vivo con artistas invitados\",\n  \"categoriaId\": 1,\n  \"fecha\": \"2027-06-20T21:00:00.000Z\",\n  \"multimedia\": [\n    \"https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=800\"\n  ],\n  \"tiposEntrada\": [\n    {\n      \"nombre\": \"General\",\n      \"descripcion\": \"Acceso general de pie\",\n      \"precio\": 18000,\n      \"cupo\": 100\n    },\n    {\n      \"nombre\": \"VIP\",\n      \"descripcion\": \"Sector preferencial con consumición\",\n      \"precio\": 35000,\n      \"cupo\": 20\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/eventos",
              "host": ["{{baseUrl}}"],
              "path": ["eventos"]
            },
            "description": "Requiere Bearer {{token}}. El organizador se toma automáticamente de req.user.id. Guarda {{eventoCreadoId}} y {{tipoEntradaCreadoId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('eventoCreadoId', data.id);",
                  "if (data.tiposEntrada && data.tiposEntrada.length > 0) {",
                  "  pm.collectionVariables.set('tipoEntradaCreadoId', data.tiposEntrada[0].id);",
                  "}"
                ]
              }
            }
